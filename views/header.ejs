<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Oathbreakers Guide</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav>
        <a href="/" class="nav-brand">Oathbreakers</a>
        <div class="nav-links">
            <% for (const [name, info] of Object.entries(tables)) { %>
            <a href="/table/<%= name %>"><%= info.display_name %></a>
            <% } %>
            <% if (typeof customTabs !== 'undefined') { customTabs.forEach(function(tab) { %>
            <a href="/table/<%= tab.id %>"><%= tab.name %></a>
            <% }); } %>
            <a href="/quests">Quests</a>
        </div>
        <div class="nav-user">
            <% if (typeof username !== 'undefined' && username) { %>
            <span class="nav-username"><%= username %></span>
            <a href="/logout" class="nav-logout">Logout</a>
            <% } %>
        </div>
    </nav>
    <main>
